{
  "manifest_version": 3,
  "name": "Zendesk Help Center Crawler (TEST)",
  "version": "1.0",
  "description": "Test version of Zendesk Help Center Crawler",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "debug-popup.html",
    "default_title": "Zendesk Crawler (TEST)"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["test-content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
} 